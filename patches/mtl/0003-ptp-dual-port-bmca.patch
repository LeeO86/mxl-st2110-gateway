+/* <0: a is the better master, >0: b is better, 0: equal (IEEE 1588-2008 9.3.4). */
+static int ptp_bmca_compare(const struct mt_ptp_bmca_ds* a, const struct mt_ptp_bmca_ds* b) {
+  if (a->priority1 != b->priority1) return a->priority1 < b->priority1 ? -1 : 1;
+  if (a->clock_class != b->clock_class) return a->clock_class < b->clock_class ? -1 : 1;
+  if (a->clock_accuracy != b->clock_accuracy)
+    return a->clock_accuracy < b->clock_accuracy ? -1 : 1;
+  if (a->offset_scaled_log_variance != b->offset_scaled_log_variance)
+    return a->offset_scaled_log_variance < b->offset_scaled_log_variance ? -1 : 1;
+  if (a->priority2 != b->priority2) return a->priority2 < b->priority2 ? -1 : 1;
+  int c = memcmp(a->gm_identity, b->gm_identity, 8);
+  if (c) return c < 0 ? -1 : 1;
+  if (a->steps_removed != b->steps_removed)
+    return a->steps_removed < b->steps_removed ? -1 : 1;
+  c = memcmp(&a->sender, &b->sender, sizeof(a->sender));
+  if (c) return c < 0 ? -1 : 1;
+  return 0;
+}
+
+static void ptp_bmca_ds_from_announce(struct mt_ptp_bmca_ds* ds,
+                                      struct mt_ptp_announce_msg* msg) {
+  ds->priority1 = msg->grandmaster_priority1;
+  ds->clock_class = msg->grandmaster_clock_quality.clock_class;
+  ds->clock_accuracy = msg->grandmaster_clock_quality.clock_accuracy;
+  ds->offset_scaled_log_variance =
+      ntohs(msg->grandmaster_clock_quality.offset_scaled_log_variance);
+  ds->priority2 = msg->grandmaster_priority2;
+  mt_memcpy(ds->gm_identity, &msg->grandmaster_identity.id[0], 8);
+  ds->steps_removed = ntohs(msg->steps_removed);
+  mt_memcpy(&ds->sender, &msg->hdr.source_port_identity, sizeof(ds->sender));
+}
+
+/* The selection across both ports: only the better parent's instance steers the PHC. */
+static void ptp_dual_select(struct mtl_main_impl* impl) {
+  struct mt_ptp_impl* p = mt_get_ptp(impl, MTL_PORT_P);
+  struct mt_ptp_impl* r = mt_get_ptp(impl, MTL_PORT_R);
+  if (!p || !r || !p->dual || !r->dual) return;
+
+  rte_spinlock_lock(&p->select_lock);
+  bool pv = p->master_initialized;
+  bool rv = r->master_initialized;
+  int current = p->selected_port;
+  int want = current;
+  if (pv && !rv)
+    want = MTL_PORT_P;
+  else if (!pv && rv)
+    want = MTL_PORT_R;
+  else if (pv && rv) {
+    int c = ptp_bmca_compare(&p->best, &r->best);
+    if (c < 0)
+      want = MTL_PORT_P;
+    else if (c > 0)
+      want = MTL_PORT_R;
+    /* equal: keep the current selection */
+  }
+  if (want != current) {
+    p->selected_port = want;
+    p->selection_changes++;
+    info("%s, PTP port %d selected to steer the PHC (was %d), changes %" PRIu64 "\n",
+         __func__, want, current, p->selection_changes);
+  }
+  rte_spinlock_unlock(&p->select_lock);
+}
