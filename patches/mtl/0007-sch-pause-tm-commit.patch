   return 0;
 }
 
+/* The caller's own sch (a tasklet calling in) is not paused: it cannot wait for itself. */
+static bool sch_is_current_thread(struct mtl_sch_impl* sch) {
+  return pthread_equal(sch->tid, pthread_self()) != 0;
+}
+
+bool mt_sch_pause_all(struct mtl_main_impl* impl) {
+  struct mt_sch_mgr* mgr = mt_sch_get_mgr(impl);
+  struct mtl_sch_impl* sch;
+
+  /* no sch yet (mtl_init): nothing polls, and the mgr lock is not initialized */
+  if (!rte_atomic32_read(&mgr->sch_cnt)) return false;
+
+  /* held until mt_sch_resume_all: mt_sch_get_by_socket starts no new sch meanwhile */
+  sch_mgr_lock(mgr);
+  for (int i = 0; i < MT_MAX_SCH_NUM; i++) {
+    sch = mt_sch_instance(impl, i);
+    if (!mt_sch_started(sch) || sch_is_current_thread(sch)) continue;
+    rte_atomic32_set(&sch->request_pause, 1);
+    if (sch->allow_sleep) sch_sleep_wakeup(sch);
+  }
+  for (int i = 0; i < MT_MAX_SCH_NUM; i++) {
+    sch = mt_sch_instance(impl, i);
+    if (!rte_atomic32_read(&sch->request_pause)) continue;
+    uint64_t start = mt_get_monotonic_time();
+    while (!rte_atomic32_read(&sch->paused) && !rte_atomic32_read(&sch->stopped)) {
+      if ((mt_get_monotonic_time() - start) > NS_PER_S) {
+        err("%s(%d), sch did not pause within 1s\n", __func__, i);
+        break;
+      }
+      mt_sleep_us(1);
+    }
+  }
+  rte_smp_mb();
+  dbg("%s, succ\n", __func__);
+  return true;
+}
+
+void mt_sch_resume_all(struct mtl_main_impl* impl) {
+  struct mt_sch_mgr* mgr = mt_sch_get_mgr(impl);
+  struct mtl_sch_impl* sch;
+
+  rte_smp_mb(); /* the port changes are done before any sch resumes */
+  for (int i = 0; i < MT_MAX_SCH_NUM; i++) {
+    sch = mt_sch_instance(impl, i);
+    if (!rte_atomic32_read(&sch->request_pause)) continue;
+    rte_atomic32_set(&sch->request_pause, 0);
+    /* left its wait before a next pause request can see a stale paused flag */
+    while (rte_atomic32_read(&sch->paused) && !rte_atomic32_read(&sch->stopped))
+      rte_pause();
+  }
+  sch_mgr_unlock(mgr);
+  dbg("%s, succ\n", __func__);
+}
