+/* Publish a consistent status snapshot for mtl_ptp_get_status (seqlock writer side). */
+static void ptp_status_publish(struct mt_ptp_impl* ptp) {
+  struct mtl_ptp_status* s = &ptp->status;
+
+  rte_spinlock_lock(&ptp->status_lock);
+  ptp->status_seq++; /* odd: update in progress */
+  rte_smp_wmb();
+  s->active = ptp->active;
+  s->locked = ptp->locked;
+  s->master_initialized = ptp->master_initialized;
+  mt_memcpy(s->parent_clock_identity, &ptp->master_port_id.clock_identity.id[0], 8);
+  s->parent_port_number = ntohs(ptp->master_port_id.port_number);
+  mt_memcpy(s->gm_identity, ptp->gm_identity, 8);
+  s->gm_priority1 = ptp->gm_priority1;
+  s->gm_priority2 = ptp->gm_priority2;
+  s->gm_clock_class = ptp->gm_clock_class;
+  s->gm_clock_accuracy = ptp->gm_clock_accuracy;
+  s->gm_offset_scaled_log_variance = ptp->gm_offset_scaled_log_variance;
+  s->steps_removed = ptp->steps_removed;
+  s->time_source = ptp->time_source;
+  s->domain_number = ptp->t1_domain_number;
+  s->utc_offset = ptp->master_utc_offset;
+  s->delta_last = ptp->delta_last;
+  s->delta_min = ptp->win_delta_min;
+  s->delta_max = ptp->win_delta_max;
+  s->delta_avg = ptp->win_delta_avg;
+  s->path_delay_last = ptp->path_delay_last;
+  s->path_delay_min = ptp->win_path_delay_min;
+  s->path_delay_max = ptp->win_path_delay_max;
+  s->path_delay_avg = ptp->win_path_delay_avg;
+  s->sync_count = ptp->sync_total + ptp->stat_sync_cnt;
+  s->gm_change_count = ptp->gm_change_count;
+  s->err_rx_sync = ptp->err_rx_sync_total + ptp->stat_rx_sync_err;
+  s->err_tx_sync = ptp->err_tx_sync_total + ptp->stat_tx_sync_err;
+  s->err_result = ptp->err_result_total + ptp->stat_result_err;
+  s->err_timeout = ptp->err_timeout_total + ptp->stat_sync_timeout_err;
+  s->phc2sys_locked = ptp->phc2sys_active && ptp->phc2sys.locked;
+  rte_smp_wmb();
+  ptp->status_seq++; /* even: consistent */
+  rte_spinlock_unlock(&ptp->status_lock);
+}
