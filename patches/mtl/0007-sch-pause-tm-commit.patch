+/* Wait outside the tasklets while mt_sch_pause_all holds this sch; sch_stop still ends it. */
+static void sch_pause_wait(struct mtl_sch_impl* sch) {
+  rte_smp_mb(); /* the tasklets' accesses are done before paused is seen */
+  rte_atomic32_set(&sch->paused, 1);
+  while (rte_atomic32_read(&sch->request_pause) &&
+         !rte_atomic32_read(&sch->request_stop)) {
+    if (sch->run_in_thread)
+      mt_sleep_us(10);
+    else
+      rte_pause();
+  }
+  rte_smp_mb(); /* the port state of the resume is seen by the next tasklets */
+  rte_atomic32_set(&sch->paused, 0);
+}
