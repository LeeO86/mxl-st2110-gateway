+/* Set while the driver restarts the DPDK port (the ice PMD for a rate-limiter commit): its
+ * fast-path ops are rewritten, so no rx/tx burst may run on it meanwhile. */
+extern uint8_t mt_dev_port_restarting_flags[RTE_MAX_ETHPORTS];
+
+static inline bool mt_dev_port_restarting(uint16_t port_id) {
+  return __atomic_load_n(&mt_dev_port_restarting_flags[port_id], __ATOMIC_ACQUIRE) != 0;
+}
+
+static inline void mt_dev_port_set_restarting(uint16_t port_id, bool restarting) {
+  __atomic_store_n(&mt_dev_port_restarting_flags[port_id], restarting ? 1 : 0,
+                   __ATOMIC_SEQ_CST);
+}
