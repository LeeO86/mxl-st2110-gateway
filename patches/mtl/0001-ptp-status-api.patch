+/** The PTP status API below is available (mtl_ptp_get_status). */
+#define MTL_HAS_PTP_STATUS 1
+
+/**
+ * PTP status of one port, a consistent snapshot published by the PTP stack.
+ * Window statistics (min/max/avg) cover the last statistics period (dump_period_s).
+ */
+struct mtl_ptp_status {
+  /** A PTP instance runs on this port. */
+  bool active;
+  /** Offset converged (|delta| < 100ns for more than 100 consecutive results). */
+  bool locked;
+  /** A parent was selected from an Announce message. */
+  bool master_initialized;
+  /** This port's PTP instance steers the PHC and answers mtl_ptp_read_time. */
+  bool selected;
+  /** Parent port identity (clock identity + port number). */
+  uint8_t parent_clock_identity[8];
+  uint16_t parent_port_number;
+  /** Grandmaster data from the latest Announce of the parent. */
+  uint8_t gm_identity[8];
+  uint8_t gm_priority1;
+  uint8_t gm_priority2;
+  uint8_t gm_clock_class;
+  uint8_t gm_clock_accuracy;
+  uint16_t gm_offset_scaled_log_variance;
+  uint16_t steps_removed;
+  uint8_t time_source;
+  uint8_t domain_number;
+  /** UTC offset announced by the parent (display only, the time scale is TAI). */
+  int16_t utc_offset;
+  /** Offset from master (ns): last result and window min/max/avg. */
+  int64_t delta_last;
+  int64_t delta_min;
+  int64_t delta_max;
+  int64_t delta_avg;
+  /** Mean path delay (ns): last result and window min/max/avg. */
+  int64_t path_delay_last;
+  int64_t path_delay_min;
+  int64_t path_delay_max;
+  int64_t path_delay_avg;
+  /** Cumulative counters since start. */
+  uint64_t sync_count;
+  uint64_t gm_change_count;
+  uint64_t selection_changes;
+  uint64_t err_rx_sync;
+  uint64_t err_tx_sync;
+  uint64_t err_result;
+  uint64_t err_timeout;
+  /** The phc2sys service (MTL_FLAG_PHC2SYS_ENABLE) reports the system clock locked. */
+  bool phc2sys_locked;
+};
+
+/**
+ * Read the PTP status of a port. A port without a PTP instance reports active = false.
+ * Lock-free for the caller; safe from any thread.
+ *
+ * @param mt
+ *   The handle to MTL instance.
+ * @param port
+ *   The port.
+ * @param status
+ *   Filled with a consistent snapshot.
+ * @return
+ *   - 0: Success.
+ *   - <0: Error code.
+ */
+int mtl_ptp_get_status(mtl_handle mt, enum mtl_port port, struct mtl_ptp_status* status);
