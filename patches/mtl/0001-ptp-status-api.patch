+int mtl_ptp_get_status(mtl_handle mt, enum mtl_port port, struct mtl_ptp_status* status) {
+  struct mtl_main_impl* impl = mt;
+
+  if (!impl || impl->type != MT_HANDLE_MAIN) return -EINVAL;
+  if (!status || port >= MTL_PORT_MAX || port >= mt_num_ports(impl)) return -EINVAL;
+
+  struct mt_ptp_impl* ptp = mt_get_ptp(impl, port);
+  memset(status, 0, sizeof(*status));
+  if (!ptp) return 0; /* no PTP instance on this port */
+
+  uint32_t seq;
+  do {
+    seq = ptp->status_seq;
+    rte_smp_rmb();
+    if (seq & 1) continue; /* writer in progress */
+    mt_memcpy(status, &ptp->status, sizeof(*status));
+    rte_smp_rmb();
+  } while ((seq & 1) || seq != ptp->status_seq);
+
+  /* without dual-port PTP only the primary port instance steers the PHC */
+  status->selected = status->active && (MTL_PORT_P == port);
+  return 0;
+}
+
 uint64_t mt_get_raw_ptp_time(struct mtl_main_impl* impl, enum mtl_port port) {
   return ptp_get_raw_time(mt_get_ptp(impl, port));
 }
