+/* Drop a parent that sent no Announce for 3 announce intervals (alarm, every second). */
+static void ptp_announce_timeout_handler(void* param) {
+  struct mt_ptp_impl* ptp = param;
+  uint64_t now = mt_get_monotonic_time();
+  bool dropped = false;
+
+  rte_spinlock_lock(&ptp->master_lock);
+  if (ptp->master_initialized) {
+    int8_t log_interval = ptp->announce_log_interval;
+    if (log_interval < -7) log_interval = -7;
+    if (log_interval > 7) log_interval = 7;
+    uint64_t interval_ns = log_interval >= 0 ? (uint64_t)NS_PER_S << log_interval
+                                             : (uint64_t)NS_PER_S >> (-log_interval);
+    if (now - ptp->last_announce_ns > 3 * interval_ns) {
+      warn("%s(%d), parent sent no Announce for 3 intervals, re-selecting\n", __func__,
+           ptp->port);
+      ptp->master_initialized = false;
+      ptp->locked = false;
+      ptp->stat_sync_keep = 0;
+      ptp_t_result_clear(ptp);
+      dropped = true;
+    }
+  }
+  rte_spinlock_unlock(&ptp->master_lock);
+  if (dropped) {
+    ptp_status_publish(ptp);
+    ptp_dual_select(ptp->impl);
+  }
+  if (ptp->active) rte_eal_alarm_set(NS_PER_S / 1000, ptp_announce_timeout_handler, ptp);
+}
